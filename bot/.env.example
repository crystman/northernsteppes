# Copy to bot/.env and fill in. .env is gitignored -- never commit real values.
# On Railway these are set as service variables instead of via a file.

DISCORD_TOKEN=
DISCORD_GUILD_ID=
LEADERSHIP_ROLE_ID=

# Railway injects this automatically; reference the Postgres service as
# ${{Postgres.DATABASE_URL}} rather than pasting a literal URL.
# Locally, point at a throwaway database -- never at Railway.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ns_bot_dev

# Repo write auth (GitHub App). Not needed until the sync job exists.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=

SYNC_DEBOUNCE_SECONDS=300
SYNC_ENABLED=false
DRY_RUN=true
